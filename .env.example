# Copy this file to a real .env and fill in your own values.
# The app reads these environment variables for the database connection.
# Never commit the real .env file.

# MySQL database URL
DB_URL=jdbc:mysql://localhost:3306/commuto?useSSL=false&serverTimezone=UTC

# MySQL username
DB_USER=root

# MySQL password
DB_PASSWORD=your_mysql_password_here
